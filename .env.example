# Development only. Copy to .env, use export from scripts/env.sh or compose --env-file.
# URL passwords must be percent-encoded if they contain reserved characters.
NODE_ENV=development
PORT=4001
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=livestar
POSTGRES_USER=livestar_owner
POSTGRES_PASSWORD=livestar_local_owner
APP_DB_PASSWORD=livestar_local_app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://livestar_app:livestar_local_app@localhost:5432/livestar?schema=public
DATABASE_MIGRATION_URL=postgresql://livestar_owner:livestar_local_owner@localhost:5432/livestar?schema=public
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
JWT_SECRET=livestar_local_development_key_replace_before_production_2026
JWT_ISSUER=livestar
JWT_AUDIENCE=livestar-clients
APP_PUBLIC_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@livestar.local
API_INTERNAL_URL=http://127.0.0.1:4001/api/v1
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=livestar_local_dev_secret_change_me_32plus
# Storage and LiveKit are optional LOCAL infrastructure. No application integrations yet.
MINIO_ROOT_USER=livestar_storage
MINIO_ROOT_PASSWORD=livestar_local_storage_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Real provider keys, webhook secrets, JWT secrets and payout credentials are
# deliberately absent until their modules and provider approvals exist.
