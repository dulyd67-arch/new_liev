    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "livekit-server-sdk": "^2.19.3",
    "nodemailer": "10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
